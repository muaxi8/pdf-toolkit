{
  "name": "dsh-pdf-toolkit",
  "version": "0.1.0",
  "description": "DeepSeek Harness PDF toolbox: open/read, edit, split, merge, handwritten signature (pdf-lib + pdfjs).",
  "author": "dsh-pdf-toolkit authors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/muaxi8/pdf-toolkit.git"
  },
  "homepage": "https://github.com/muaxi8/pdf-toolkit#readme",
  "bugs": {
    "url": "https://github.com/muaxi8/pdf-toolkit/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
